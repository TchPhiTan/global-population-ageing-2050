      <aliases enabled='yes' />
      <column caption='Is Country' datatype='string' name='[Calculation_3057377430536192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LEN([Code]) = 3&#10;   AND UPPER([Code]) = [Code]&#10;   AND NOT STARTSWITH([Code], &quot;OWID_&quot;)&#10;   AND NOT STARTSWITH([Code], &quot;UN_&quot;)&#10;   AND [Code] != &quot;&quot;&#10;THEN &quot;Country&quot;&#10;ELSEIF [Code] = &quot;OWID_KOS&quot; THEN &quot;Country&quot;&#10;ELSE &quot;Region/Aggregate&quot;&#10;END' />
      </column>
      <column caption='Population (Millions)' datatype='real' name='[Calculation_3057377430884353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Indicator] = &quot;Population&quot; THEN [Value] / 1000000 END' />
      </column>
      <column caption='Population (Billions)' datatype='real' name='[Calculation_3057377430925314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Indicator] = &quot;Population&quot; THEN [Value] / 1000000000 END' />
      </column>
      <column caption='Growth Rate (%)' datatype='real' name='[Calculation_3057377430966275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Indicator] = &quot;Population growth rate&quot; THEN [Value] END' />
      </column>
      <column caption='TFR' datatype='real' name='[Calculation_3057377431027716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Indicator] = &quot;Total fertility rate&quot; THEN [Value] END' />
      </column>
      <column caption='Data Period' datatype='string' name='[Calculation_3057377431089157]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DataStatus] = &quot;estimate&quot; THEN &quot;Lịch sử (Ước tính)&quot; &#10;ELSEIF [DataStatus] = &quot;projected&quot; THEN &quot;Dự phóng (UN WPP)&quot; &#10;ELSE &quot;Dự báo (Mô hình)&quot; &#10;END' />
      </column>
      <column caption='Below Replacement' datatype='string' name='[Calculation_3057377431130118]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3057377431027716] &lt; 2.1 THEN &quot;Dưới mức thay thế&quot; ELSE &quot;Trên mức thay thế&quot; END' />
      </column>
      <column caption='Growth Category' datatype='string' name='[Calculation_3057377431175175]' role='dimension' type='nominal'>
